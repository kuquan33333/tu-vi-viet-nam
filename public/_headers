/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src https://qimen-2i1.pages.dev https://aicuc.github.io https://www.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/ho-so
  ! Cache-Control
  Cache-Control: no-store
